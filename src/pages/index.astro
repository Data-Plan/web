---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import AppleIcon from "../components/icons/AppleIcon.astro";
import appIcon from "../assets/appicon.png";
import screenshotPlans from "../assets/website.screenshot.1.png";
import screenshotOverLimit from "../assets/website.screenshot.2.png";
import screenshotWidgets from "../assets/website.screenshot.3.png";

const screenshots = [
    {
        src: screenshotPlans,
        alt: "Data Plan showing 10.88 GB of a 30 GB cycle used, with today's and yesterday's usage below",
    },
    {
        src: screenshotOverLimit,
        alt: "Data Plan showing an eSIM plan with today's usage over its daily limit",
    },
    {
        src: screenshotWidgets,
        alt: "Data Plan widgets on the iPhone Home Screen showing today's and the current cycle's usage",
    },
];
---

<Layout>
    <main class="flex grow flex-col items-center px-4 py-20">
        <div
            class="flex w-full max-w-4xl flex-col items-center gap-6 text-center"
        >
            <Image
                src={appIcon}
                alt=""
                width={100}
                height={100}
                densities={[1, 2, 3]}
                class="h-25 w-25 rounded-[1.6em] border border-black/5 shadow-lg"
            />
            <h1
                class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl"
            >
                Data Plan
            </h1>
            <p class="max-w-md text-lg text-slate-600">
                Tracks your mobile and Wi-Fi usage<br />
                and warns you before you hit your limits.
            </p>
            <a
                href="https://apps.apple.com/app/id6747405723"
                class="inline-flex items-center gap-2 rounded-full bg-black px-5 py-3 text-sm font-medium text-white transition hover:bg-black/80"
            >
                <AppleIcon class="h-4 w-4" />
                Download for iOS
            </a>
        </div>

        <ul class="mt-20 grid w-full max-w-4xl gap-10 sm:grid-cols-3 sm:gap-6">
            {
                screenshots.map(({ src, alt }, index) => (
                    <li class="flex justify-center">
                        <Image
                            src={src}
                            alt={alt}
                            widths={[280, 560]}
                            sizes="(min-width: 640px) 280px, 260px"
                            loading={index === 0 ? "eager" : "lazy"}
                            class="w-64 sm:w-full"
                        />
                    </li>
                ))
            }
        </ul>
    </main>
</Layout>
